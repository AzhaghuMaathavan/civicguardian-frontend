# Vercel Deployment Environment Variables
# https://vercel.com/docs/environment-variables
# https://vercel.com/docs/projects/environment-variables#system-environment-variables
# https://vercel.com/docs/projects/environment-variables#storing-environment-variables-in-code

# Public API URL — set this to your deployed API base URL.
# Crypto sanitiser note:
#   This value is public-fetchable by the browser, so NEVER put secrets here.
NEXT_PUBLIC_API_URL=https://cgapi.shyxon.com

# Optional: If you also deploy the api-mock server (for local development without the real backend)
# NEXT_PUBLIC_API_MOCK_URL=http://localhost:4000
